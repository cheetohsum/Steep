; Script initially generated by the Inno Setup Script Wizard.
; Documentation: http://www.jrsoftware.org/ishelp/
;
; This script is used by "Inno Setup" (http://www.jrsoftware.org/) to create a
; setup executable. When the "make install" process ends, double-click on this
; file to load it into Inno Setup, then execute it to create the installer. It
; expects to find all the dependency libs in the root destination folder (the
; one from the 'make install' process), and the usual 'lib' directory.
; Note that all *.dll files will be added, so be careful which DLLs are present
; in the folder before running this script.
;
; This script searches for and bundles all "steep*.exe" files, allowing
; you to bundle a "release" as well as a "debug" version at the same time.
; At least one "steep.exe" file is required.
;
; This script is configured to check that the operating system's bit depth is
; the same as that of the executable file.
;
; The IA-64 architecture is not supported.

#define MyAppName "Steep"
#define MyAppVersion "${GIT_DESCRIBE}"
#define MyAppVersionNumeric "${GIT_NUMERIC_VERSION_BS}"
#define MyAppPublisher "github.com/cheetohsum/Steep"
#define MyAppURL "https://github.com/cheetohsum/Steep"
#define MyAppExeName "steep.exe"
#define MyAppCliExeName "steep-cli.exe"
#define MyBuildBasePath "${CMAKE_INSTALL_PREFIX}"
#define MySourceBasePath "${PROJECT_SOURCE_DIR}"
#define MyBitDepth "${BUILD_BIT_DEPTH}"
#define MyTargetArchitecture "${ARCHITECTURE_ALLOWED}"
#define MyInstallMode "${INSTALL_MODE}"
#define MySystemName "${SYSTEM_NAME}"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
;
; This MUST stay fixed forever. It used to be {#MyAppName}{#MyAppVersion},
; which put the version inside the identity, so every build registered as a
; different product: Windows never recognised an existing Steep, nothing was
; ever upgraded, and users collected one uninstall entry per build. With a
; constant AppId, Setup finds the previous install, reuses its directory and
; Start Menu group, and replaces it in place.
AppId={{60BBE256-B960-4DA2-9FB7-A61AD3F47D84}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
; Left off deliberately. GIT_NUMERIC_VERSION_BS is only a version number
; when git describe finds a tag; CI clones without tags, so it degrades to
; "<hash>.<count>" (e.g. 35edaed0b.223) and ISCC rejects it outright:
;   Value of [Setup] section directive "VersionInfoVersion" is invalid.
; Nothing here needs it -- AppId alone is what makes updates work.
;VersionInfoVersion={#MyAppVersionNumeric}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; No version in the path: an update must land on top of the old install
; rather than beside it. {autopf} (not {pf}) because PrivilegesRequired=none
; means Setup may be running unelevated, where Program Files is unwritable.
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
; When a previous install is found, keep where the user put it last time.
UsePreviousAppDir=yes
UsePreviousGroup=yes
UsePreviousTasks=yes
UsePreviousLanguage=yes
; Let Setup shut a running Steep instead of failing to overwrite its files.
CloseApplications=yes
RestartApplications=no
AllowNoIcons=yes
LicenseFile={#MyBuildBasePath}\LICENSE
OutputDir={#MyBuildBasePath}\..\
OutputBaseFilename={#MyAppName}_{#MyAppVersion}_{#MySystemName}_{#MyBitDepth}
SetupIconFile={#MySourceBasePath}\rtdata\images\steep.ico
WizardImageFile={#MySourceBasePath}\tools\win\InnoSetup\installerStrip.bmp
WizardImageBackColor=$141724
Compression=lzma
SolidCompression=yes
ArchitecturesAllowed={#MyTargetArchitecture}
ArchitecturesInstallIn64BitMode={#MyInstallMode}
PrivilegesRequired=none

