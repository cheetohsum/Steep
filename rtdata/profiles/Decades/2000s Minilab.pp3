# A digital minilab print of the two-thousands: bright, slightly red, glossy.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections. Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=heritage_gold
ModelVersion=6
PushPull=0
Process=auto
Output=labscan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=90
Contrast=-12
Saturation=25
Warmth=0
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=true
ShadowsHue=0
ShadowsSat=0
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=28
HighlightsSat=0.225
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[ColorToning]
Enabled=false
Method=LabGrid
LabGridALow=0
LabGridBLow=0
LabGridAHigh=0
LabGridBHigh=0

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0000;0.06;0.0449;0.125;0.0956;0.25;0.2054;0.375;0.3356;0.5;0.4800;0.625;0.6244;0.75;0.7546;0.875;0.8644;0.94;0.9151;1;0.9600;
aCurve=0;
bCurve=0;

[Black & White]
Enabled=false

[Grain]
Enabled=false
ISO=400
Strength=0
Scale=100
Color=0

[Light Effects]
Enabled=false
Threshold=70
Glow=0
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0

[PCVignette]
Enabled=false
Strength=0
Feather=50
Roundness=50

[TiltShift]
Enabled=false
Amount=0
FocusPos=50
FocusWidth=20
Feather=50
Angle=0

[Gradient]
Enabled=false
Degree=0
Feather=40
Strength=0
CenterX=0
CenterY=0

[SoftLight]
Enabled=true
Strength=15

[Dehaze]
Enabled=false
Strength=50

[Clarity]
Enabled=false
Radius=100
Amount=0

[Texture]
Enabled=false
Radius=20
Amount=0
