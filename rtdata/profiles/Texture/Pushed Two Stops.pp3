# Fast film pushed hard: contrast, blocked shadows and very coarse grain.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections, and the rest of the edit is always kept.
[Steep Look]
Version=2
Kind=look
Id=texture-pushed-two-stops
Family=grit

[Film Presets]
Enabled=true
Preset=street_800
ModelVersion=6
PushPull=0.3
Process=auto
Output=scan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=80
Contrast=10
Saturation=0
Warmth=0
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=false
ShadowsHue=0
ShadowsSat=0
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=0
HighlightsSat=0
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[ColorToning]
Enabled=false
Method=LabGrid
LabGridALow=0
LabGridBLow=0
