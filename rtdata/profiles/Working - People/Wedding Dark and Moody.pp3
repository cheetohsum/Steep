# Dark and moody: lowered mid-tones, thin colour, amber highlights, shaded corners.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections. Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=twilight_160
ModelVersion=6
PushPull=0
Process=auto
Output=scan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=70
Contrast=0
Saturation=-28
Warmth=0
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=true
ShadowsHue=150
ShadowsSat=0.135
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=74
HighlightsSat=0.18
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[ColorToning]
Enabled=false
Method=LabGrid
LabGridALow=0
LabGridBLow=0
LabGridAHigh=0
LabGridBHigh=0

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0250;0.06;0.0611;0.125;0.1027;0.25;0.1978;0.375;0.3190;0.5;0.4618;0.625;0.6124;0.75;0.7555;0.875;0.8835;0.94;0.9449;1;1.0000;
aCurve=0;
bCurve=0;

[Black & White]
Enabled=false

[Grain]
Enabled=false
ISO=400
Strength=0
Scale=100
Color=0

[Light Effects]
