# The loud version: deep teal shadows, hot amber highlights, more contrast and colour.
# Graded look: owns Film Lab, colour grading, the Lab curve and the Black-and-White switch,
# plus the finish sections listed below. It never sets exposure, white balance, crop or lens corrections.
# Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=cinema_reveal_35
ModelVersion=6
PushPull=0
Process=auto
Output=cinema
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=100
Contrast=0
Saturation=8
Warmth=0
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=true
ShadowsHue=205
ShadowsSat=0.45
ShadowsLum=0
MidtonesHue=60
MidtonesSat=0.075
MidtonesLum=0
HighlightsHue=74
HighlightsSat=0.3
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=100

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0000;0.06;0.0462;0.125;0.0985;0.25;0.2125;0.375;0.3485;0.5;0.5000;0.625;0.6515;0.75;0.7875;0.875;0.9015;0.94;0.9538;1;1.0000;

[Black & White]
Enabled=false
