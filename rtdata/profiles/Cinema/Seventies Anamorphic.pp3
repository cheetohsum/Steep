# Seventies widescreen: warm, a little thin, yellowed highlights, soft glow and visible grain.
# Graded look: owns Film Lab, colour grading, the Lab curve and the Black-and-White switch,
# plus the finish sections listed below. It never sets exposure, white balance, crop or lens corrections.
# Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=twilight_160
ModelVersion=6
PushPull=0
Process=auto
Output=cinema
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=70
Contrast=0
Saturation=-15
Warmth=6
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=true
ShadowsHue=150
ShadowsSat=0.075
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=95
HighlightsSat=0.125
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0400;0.06;0.1016;0.125;0.1676;0.25;0.2908;0.375;0.4076;0.5;0.5200;0.625;0.6324;0.75;0.7492;0.875;0.8724;0.94;0.9384;1;1.0000;

[Grain]
Enabled=true
ISO=400
Strength=25
Scale=100
Color=0

[Light Effects]
Enabled=true
Threshold=70
Glow=15
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0

[Black & White]
Enabled=false
