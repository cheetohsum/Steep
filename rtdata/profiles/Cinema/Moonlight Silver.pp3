# Day for night taken further: silver-cyan, nearly colourless, highlights held well down.
# Graded look: owns Film Lab, colour grading, the Lab curve and the Black-and-White switch,
# plus the finish sections listed below. It never sets exposure, white balance, crop or lens corrections.
# Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=cinematic_500t
ModelVersion=6
PushPull=0
Process=auto
Output=scan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=100
Contrast=0
Saturation=-65
Warmth=-40
Tint=0
Fade=0
Rolloff=0
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=0
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0

[Color Grading]
Enabled=true
ShadowsHue=0
ShadowsSat=0
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=-5
HighlightsHue=0
HighlightsSat=0
HighlightsLum=-10
GlobalHue=222
GlobalSat=0.15
GlobalLum=0
Blending=100
Balance=60

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0000;0.06;0.0455;0.125;0.0960;0.25;0.2002;0.375;0.3160;0.5;0.4400;0.625;0.5640;0.75;0.6798;0.875;0.7840;0.94;0.8345;1;0.8800;

[Black & White]
Enabled=false
