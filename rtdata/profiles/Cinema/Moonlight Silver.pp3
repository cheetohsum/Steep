# Day for night taken further: silver-cyan, nearly colourless, highlights held well down.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections. Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=true
Preset=cinematic_500t
ModelVersion=6
PushPull=0
Process=auto
Output=scan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=100
