# Two-tone grain: every speck black or white.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-grain-grain-stipple
Family=layer

[Grain]
Enabled=true
ISO=800
Strength=90
Scale=100
Color=0
Style=stipple
