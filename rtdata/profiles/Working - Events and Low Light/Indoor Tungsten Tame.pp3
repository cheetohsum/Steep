# Takes the orange out of warm indoor light without changing white balance.
# Film-only recipe: preserves exposure, white balance, geometry and local edits.
[Steep Look]
Version=1
Kind=film
Id=working-events-and-low-light-indoor-tungsten-tame
Family=low-light

[Film Presets]
