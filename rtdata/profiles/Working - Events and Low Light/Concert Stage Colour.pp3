# Stage lighting: saturated LEDs kept from clipping to flat colour.
# Film-only recipe: preserves exposure, white balance, geometry and local edits.
[Steep Look]
Version=1
Kind=film
Id=working-events-and-low-light-concert-stage-colour
Family=concert

[Film Presets]
Enabled=true
Preset=cinema_reveal_35
ModelVersion=6
Exposure=0
PrintExposure=0
PushPull=0
Process=auto
Output=scan
Format=35mm
Backing=auto
BWFilter=none
LensDesign=slr
Strength=100
Contrast=-10
Saturation=-15
Warmth=0
Tint=0
Fade=0
Rolloff=60
ShadowHue=220
ShadowTint=0
MidHue=35
MidTint=0
HighlightHue=40
HighlightTint=0
Halation=0
RedShift=0
GreenShift=0
BlueShift=0
Grain=0
Vibrance=0
SkinProtection=35
LayerCoupling=-30
GrainSize=0
GrainClumping=0
GrainColor=0
HalationSize=0
HalationThreshold=0
LightSources=0
FilmSharpness=0
HalationColor=0
Bloom=0
OutputSoftness=0
