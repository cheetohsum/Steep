# A blue-white negative on black, like a film on a light box.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections. Apply with the fill option off so the rest of the edit is kept.

[Film Presets]
Enabled=false

[Color Grading]
Enabled=false
ShadowsHue=0
ShadowsSat=0
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=0
HighlightsSat=0
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[ColorToning]
Enabled=true
Method=LabGrid
LabGridALow=-4000
LabGridBLow=-30000
LabGridAHigh=-2000
LabGridBHigh=-6000

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;1;1;0;
aCurve=0;
bCurve=0;

[Black & White]
Enabled=true
Method=Desaturation

[Grain]
Enabled=false
ISO=400
Strength=0
Scale=100
Color=0
Style=film

[Light Effects]
Enabled=false
Threshold=70
Glow=0
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0

[PCVignette]
Enabled=false
Strength=0
Feather=50
Roundness=50

[TiltShift]
Enabled=false
Amount=0
FocusPos=50
FocusWidth=20
Feather=50
Angle=0

[Gradient]
Enabled=false
Degree=0
Feather=40
Strength=0
CenterX=0
CenterY=0

[SoftLight]
Enabled=false
Strength=30

[Dehaze]
Enabled=false
Strength=50

[Clarity]
Enabled=false
Radius=100
Amount=0

[Texture]
Enabled=false
Radius=20
Amount=0
