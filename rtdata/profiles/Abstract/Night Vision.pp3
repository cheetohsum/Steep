# Image-intensifier green: bright, noisy, dark at the edges.
# Look: owns Film Lab, colour grading and toning, the Lab curves, the Black-and-White
# switch and the finish tools below. It never sets exposure, white balance, crop or lens
# corrections, and the rest of the edit is always kept.
[Steep Look]
Version=2
Kind=look
Id=abstract-night-vision
Family=duotone

[Film Presets]
Enabled=false

[Color Grading]
Enabled=false
ShadowsHue=0
ShadowsSat=0
ShadowsLum=0
MidtonesHue=0
MidtonesSat=0
MidtonesLum=0
HighlightsHue=0
HighlightsSat=0
HighlightsLum=0
GlobalHue=0
GlobalSat=0
GlobalLum=0
Blending=100
Balance=60

[ColorToning]
Enabled=true
Method=LabGrid
LabGridALow=-30000
LabGridBLow=26000
LabGridAHigh=-34000
LabGridBHigh=30000

[Luminance Curve]
Enabled=true
Brightness=0
Contrast=0
Chromaticity=0
LCurve=1;0;0.0000;0.06;0.0545;0.125;0.1155;0.25;0.2434;0.375;0.3880;0.5;0.5416;0.625;0.6889;0.75;0.8154;0.875;0.9164;0.94;0.9610;1;1.0000;
aCurve=0;
bCurve=0;

[Black & White]
Enabled=true
Method=Desaturation

[Grain]
Enabled=true
ISO=3200
Strength=75
Scale=100
Color=0
Style=film

[Light Effects]
Enabled=true
Threshold=70
Glow=30
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0

[PCVignette]
Enabled=true
Strength=1.25
Feather=35
Roundness=50

[TiltShift]
Enabled=false
Amount=0
FocusPos=50
FocusWidth=20
Feather=50
Angle=0

[Gradient]
Enabled=false
Degree=0
Feather=40
Strength=0
CenterX=0
CenterY=0

[SoftLight]
Enabled=false
Strength=30

[Dehaze]
Enabled=false
Strength=50

[Clarity]
Enabled=false
Radius=100
Amount=0

[Texture]
Enabled=false
Radius=20
Amount=0
