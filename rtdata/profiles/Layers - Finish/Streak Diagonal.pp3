# A diagonal streak, as from a smeared front element.
# Layer: carries only the sections below, so it stacks on the current look.
# Apply with the fill option off; it never sets exposure or white balance.

[Light Effects]
Enabled=true
Threshold=50
Glow=0
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=80
FlareLength=60
FlareAngle=35
