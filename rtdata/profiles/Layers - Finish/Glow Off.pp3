# Removes glow and streaks.
# Layer: carries only the sections below, so it stacks on the current look.
# Apply with the fill option off; it never sets exposure or white balance.

[Light Effects]
Enabled=false
Threshold=70
Glow=0
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0
