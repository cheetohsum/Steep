# Removes glow and streaks.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-finish-glow-off
Family=layer

[Light Effects]
Enabled=false
Threshold=70
Glow=0
GlowRadius=25
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0
