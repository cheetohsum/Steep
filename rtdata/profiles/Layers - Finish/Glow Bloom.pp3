# Highlights bloom well into their surroundings.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-finish-glow-bloom
Family=layer

[Light Effects]
Enabled=true
Threshold=50
Glow=85
GlowRadius=50
Halation=0
HalationSize=30
HalationWarmth=70
Flare=0
FlareLength=40
FlareAngle=0
