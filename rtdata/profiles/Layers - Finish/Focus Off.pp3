# Removes the tilt-shift blur.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-finish-focus-off
Family=layer

[TiltShift]
Enabled=false
Amount=0
FocusPos=50
FocusWidth=20
Feather=50
Angle=0
