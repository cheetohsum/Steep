# A slanted band of focus.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-finish-focus-diagonal
Family=layer

[TiltShift]
Enabled=true
Amount=60
FocusPos=50
FocusWidth=18
Feather=50
Angle=35
