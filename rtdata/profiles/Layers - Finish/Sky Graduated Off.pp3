# Removes the graduated filter.
# Layer: carries only the sections below, so it stacks on the current look.
# It never sets exposure or white balance.
[Steep Look]
Version=2
Kind=look
Id=layers-finish-sky-graduated-off
Family=layer

[Gradient]
Enabled=false
Degree=0
Feather=25
Strength=0.6
CenterX=0
CenterY=0
